# Vorlage fuer den produktiven Server. Als .env kopieren und Werte anpassen.
COMPOSE_PROJECT_NAME=marghl-luanti
LUANTI_PORT=30000
SERVICE_UID=109
SERVICE_GID=111
TZ=Europe/Berlin

LUANTI_RUNTIME_PATH=/srv/luanti/runtime
LUANTI_WORLD_PATH=/srv/luanti/world
LUANTI_GAME_PATH=/srv/luanti/games
LUANTI_MODS_PATH=/srv/luanti/mods
LUANTI_MOD_DATA_PATH=/srv/luanti/mod_data
MAPSERVER_DATA_PATH=/srv/luanti/mapserver
PROMETHEUS_DATA_PATH=/srv/luanti/prometheus
PUSHGATEWAY_DATA_PATH=/srv/luanti/pushgateway
GRAFANA_DATA_PATH=/srv/luanti/grafana

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<langes-zufaelliges-passwort>
