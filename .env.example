# Lokale Standardwerte. Keine Geheimnisse in diese Datei eintragen.
COMPOSE_PROJECT_NAME=marghl-luanti
HTTP_PORT=8080
HTTPS_PORT=8443
LUANTI_PORT=30000
LUANTI_IMAGE=ghcr.io/luanti-org/luanti:5.17.0
CADDY_IMAGE=docker.io/library/caddy:2.10.2
MAPSERVER_SITE=http://map.localhost
WIKI_SITE=http://wiki.localhost
GRAFANA_SITE=http://grafana.localhost
MAPSERVER_IMAGE=localhost/marghl-mapserver:4.10.0
MAPSERVER_VERSION=v4.10.0
MAPSERVER_PORT=8081
MEDIAWIKI_IMAGE=localhost/marghl-mediawiki:1.43.11
MEDIAWIKI_DB_IMAGE=docker.io/library/mariadb:11.4.13
MEDIAWIKI_PORT=8082
MEDIAWIKI_SERVER=http://localhost:8082
PUSHGATEWAY_IMAGE=docker.io/prom/pushgateway:v1.11.4
PUSHGATEWAY_PORT=9091
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.15.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_DATA_PATH=prometheus-data
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.4
GRAFANA_PORT=3000
GRAFANA_DATA_PATH=grafana-data
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOCAL_UID=1000
LOCAL_GID=1000
# Numerische UID/GID des produktiven Dienstbenutzers (auf dem Zielserver: luanti).
SERVICE_UID=109
SERVICE_GID=111
LUANTI_RUNTIME_PATH=./state/runtime
LUANTI_WORLD_PATH=./state/world
LUANTI_GAME_PATH=../serverdaten/luanti/games
LUANTI_MODS_PATH=./state/mods
LUANTI_MOD_DATA_PATH=../serverdaten/luanti/.minetest/mod_data
MAPSERVER_DATA_PATH=./state/mapserver

# Produktive Pfade werden auf dem Server in dessen .env-Datei gesetzt.
# SERVICE_UID=109
# SERVICE_GID=111
# LUANTI_WORLD_PATH=/srv/luanti/world
# MAPSERVER_DATA_PATH=/srv/luanti/mapserver
# GRAFANA_DATA_PATH=/srv/luanti/grafana
# PROMETHEUS_DATA_PATH=/srv/luanti/prometheus
# GRAFANA_ADMIN_PASSWORD=<langes-zufaelliges-passwort>
